{
    "name": "ng-scaffolding",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "dev": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:ng-scaffolding": "node dist/ng-scaffolding/server/server.mjs",
        "db:start": "npx supabase start",
        "db:stop": "npx supabase stop",
        "db:reset": "npx supabase db reset",
        "db:migrate": "npx supabase migration up",
        "dev:all": "concurrently -k -n DB,WEB \"npm run db:start\" \"npm run dev\"",
        "pretty": "prettier --write \"./**/*.{html,js,jsx,mjs,cjs,ts,tsx,json,scss,css}\"",
        "pretty:quick": "pretty-quick",
        "pretty:staged": "pretty-quick --staged",
        "pretty:check": "pretty-quick --check"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.3.7",
        "@angular/common": "^20.3.7",
        "@angular/compiler": "^20.3.7",
        "@angular/core": "^20.3.7",
        "@angular/forms": "^20.3.7",
        "@angular/platform-browser": "^20.3.7",
        "@angular/platform-browser-dynamic": "^20.3.7",
        "@angular/platform-server": "^20.3.7",
        "@angular/router": "^20.3.7",
        "@angular/ssr": "^20.3.7",
        "@ntv360/component-pantry": "^0.3.1",
        "@supabase/supabase-js": "^2.88.0",
        "axios": "^1.12.2",
        "concurrently": "^9.0.1",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "husky": "^9.0.11",
        "lottie-web": "^5.13.0",
        "ng-apexcharts": "^1.17.1",
        "prettier": "^3.3.2",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^20.3.7",
        "@angular/cdk": "^20.2.13",
        "@angular/cli": "^20.3.7",
        "@angular/compiler-cli": "^20.3.7",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@types/express": "^5.0.4",
        "@types/jasmine": "~5.1.0",
        "@types/node": "^20.19.23",
        "autoprefixer": "^10.4.22",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "pretty-quick": "^4.2.2",
        "supabase": "^2.76.15",
        "tailwindcss": "^3.4.18",
        "typescript": "~5.8.3"
    }
}
